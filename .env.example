# === VerifiedPulse Environment Configuration ===

# === LLM Providers (automatic rotation) ===
# The system tries providers in priority order; on failure it automatically
# falls over to the next. Leave any you don't use blank.

# 1. OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free

# 2. Groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# 3. Google AI Studio
GOOGLE_AI_API_KEY=your_google_ai_api_key
GOOGLE_AI_MODEL=gemini-3.6-flash

# 4. Legacy OpenAI-compatible (fallback)
LLM_API_KEY=your_llm_api_key
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Rotation strategy: "priority" (failover to next on error, default) or "round-robin"
LLM_PROVIDER_STRATEGY=priority

# === Server ===
PORT=3000

# === Search ===
SEARCH_API_KEY=your_search_api_key
SEARCH_API_URL=https://api.tavily.com/search
SEARCH_MAX_RESULTS=5
